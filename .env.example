# Copy to .env and adjust. Values match docker-compose.yml.
# pnpm dev, pnpm preview, and the built server check these at startup.

# Required. The app database.
DATABASE_URL=postgresql://todo:todo@localhost:5434/todo_over_kill

# Required, even though only the tests connect to it. The compose init script
# creates this database next to the app database.
DATABASE_URL_TEST=postgresql://todo:todo@localhost:5434/todo_over_kill_test

# Optional. Leave empty to disable the AI assistant.
OPENROUTER_API_KEY=

# Optional. Defaults to openai/gpt-4o-mini when empty.
OPENROUTER_MODEL=
