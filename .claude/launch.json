{
  "version": "0.0.1",
  "configurations": [
    {
      // Applies pending migrations, then serves the app. PORT comes from the tool that starts it
      // (Claude Code desktop Preview, or handoff); without it the app runs on 5173.
      "name": "todoOverKill",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "pnpm exec prisma migrate deploy && pnpm dev"],
      "port": 5173,
      "autoPort": true,
      // The local values from .env.example and docker-compose.yml, so a fresh checkout without .env starts.
      "env": {
        "DATABASE_URL": "postgresql://todo:todo@localhost:5434/todo_over_kill",
        "DATABASE_URL_TEST": "postgresql://todo:todo@localhost:5434/todo_over_kill_test"
      }
    }
  ]
}
